generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  password         String
  name             String        @default("Admin")
  avatar           String?
  bio              String?
  role             String        @default("Legal Specialist")
  createdAt        DateTime      @default(now())
  twoFactorEnabled Boolean       @default(false)
  twoFactorSecret  String?
  articles         Article[]
  landingPages     LandingPage[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[] @relation("ArticleToTag")
}

model Article {
  id          String    @id @default(dbgenerated("md5(((random())::text || (clock_timestamp())::text))"))
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String
  category    String
  readTime    String
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  authorId    String?
  categoryId  String?
  ogImage     String?
  publishedAt DateTime?
  seoDesc     String?
  seoTitle    String?
  status      String    @default("draft")
  faq         Json?
  author      User?     @relation(fields: [authorId], references: [id])
  categoryRel Category? @relation(fields: [categoryId], references: [id])
  tags        Tag[]     @relation("ArticleToTag")

  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([authorId])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())

  @@index([isActive])
  @@index([subscribedAt])
}

model NewsletterBroadcast {
  id           String     @id @default(cuid())
  articleId    String
  articleTitle String
  totalSent    Int        @default(0)
  sentAt       DateTime   @default(now())
  emailLogs    EmailLog[]

  @@index([articleId])
  @@index([sentAt])
}

model EmailLog {
  id           String               @id @default(cuid())
  recipient    String
  subject      String
  status       String
  errorMessage String?
  broadcastId  String?
  source       String
  sentAt       DateTime             @default(now())
  broadcast    NewsletterBroadcast? @relation(fields: [broadcastId], references: [id])

  @@index([broadcastId])
  @@index([recipient])
  @@index([status])
  @@index([sentAt])
}

model SystemSetting {
  key   String @id
  value String
}

// In-house WhatsApp CTA rotator, replacing the external mauorder.online
// service — lets us see per-number traffic and enforce fairness (always
// route to whichever active number has the fewest clicks so far).
model WhatsAppNumber {
  id         String          @id @default(cuid())
  number     String          @unique // digits only, ready for wa.me/<number>
  label      String?
  isActive   Boolean         @default(true)
  clickCount Int             @default(0)
  createdAt  DateTime        @default(now())
  clicks     WhatsAppClick[]
}

// Per-page (and optionally per-button) override for the rotator: lets admin
// set a custom WA autotext and/or restrict which numbers rotate for a page,
// without a code deploy. Keyed by (path, ctaId) — path is the same page-path
// string every getWhatsAppLink() click already sends as `product`; ctaId is
// "" (empty-string sentinel, not null, so the unique constraint actually
// enforces "one page-wide row") for a whole-page override, or a specific
// button's stable id (see getWhatsAppLink's ctaId param — hand-assigned per
// button, NOT derived from its message text, so an override survives the
// button's copy being edited later) for a single-button override. numberIds
// (rotator pool restriction) only makes sense at the page level — button-
// level rows only ever carry a message override.
model WhatsAppPageConfig {
  id        String   @id @default(cuid())
  path      String
  ctaId     String   @default("")
  message   String? // null/empty = keep whatever text the CTA button sends
  numberIds String[] @default([]) // subset of WhatsAppNumber.id; empty = all active numbers; page-level (ctaId="") only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([path, ctaId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum AttributionChannel {
  GOOGLE_ADS
  META_ADS
  ORGANIC_SEARCH
  REFERRAL
  DIRECT
  OTHER
  UNKNOWN
}

enum LeadEventType {
  WHATSAPP_CTA_CLICKED
  WHATSAPP_REDIRECTED
  CONVERSATION_CONFIRMED
  STAGE_CHANGED
  NOTE_ADDED
  LEAD_REOPENED
}

// Every rotator click doubles as a lead: leadCode is embedded straight into
// the pre-filled WhatsApp message text (the only channel that actually
// carries data from this backend into the real WA conversation), so CS can
// read it off the incoming chat and staff can look the same lead up here to
// track it through to closing.
model WhatsAppClick {
  id                 String             @id @default(cuid())
  leadCode           String             @unique
  numberId           String
  number             WhatsAppNumber     @relation(fields: [numberId], references: [id])
  domain             String?
  // Entry-point attribution: "gads" | "metaads" | "seo" | "direct" | "other".
  // First-touch — captured client-side on landing, persisted in a cookie so
  // it survives browsing to whichever product page the WA click happens on.
  source             String?
  sourceCode         String             @default("unknown")
  channel            AttributionChannel @default(UNKNOWN)
  referralCode       String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  gclid              String?
  fbclid             String?
  entryUrl           String?
  entryPath          String?
  referrerUrl        String?
  ctaId              String?
  ctaLabel           String?
  anonymousSessionId String?
  deduplicationKey   String?
  // "CTA Location" (see CONTEXT.md) — which page the CTA was clicked from,
  // e.g. "/layanan/sertifikasi-iso". Coarse: doesn't distinguish between
  // multiple packages/buttons on the same page.
  product            String?
  // "Interested Service" (see CONTEXT.md) — the actual WA message text the
  // CTA carries, e.g. "...saya tertarik dengan Paket PKP Pulau Jawa...".
  // Every getWhatsAppLink() call site already writes a specific message per
  // button/package, so this is far more precise than the page path alone —
  // it's the only signal that tells "Paket Pulau Jawa" from "Paket Luar
  // Jawa" when both buttons live on the same product page.
  service            String?
  status             LeadStatus         @default(NEW)
  notes              String?
  lostReason         String?
  orderValue         Int?
  currency           String             @default("IDR")
  wonAt              DateTime?
  lostAt             DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  events             LeadEvent[]
  stageHistory       LeadStageHistory[]

  @@index([numberId])
  @@index([createdAt])
  @@index([status])
  @@index([source])
  @@index([channel, createdAt])
  @@index([referralCode, createdAt])
  @@index([deduplicationKey, createdAt])
  @@index([product])
}

model LeadEvent {
  id        String        @id @default(cuid())
  leadId    String
  lead      WhatsAppClick @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadEventType
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([leadId, createdAt])
  @@index([type, createdAt])
}

model LeadStageHistory {
  id              String        @id @default(cuid())
  leadId          String
  lead            WhatsAppClick @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage       LeadStatus
  toStage         LeadStatus
  changedByUserId String?
  reason          String?
  createdAt       DateTime      @default(now())

  @@index([leadId, createdAt])
}

model ContactSubmission {
  id           String   @id @default(cuid())
  name         String
  businessName String?
  email        String
  whatsapp     String
  topic        String
  message      String
  status       String   @default("new")
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model Redirect {
  id          String   @id @default(cuid())
  domain      String   @default("easylegal.my.id")
  slug        String
  destination String
  description String?
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([domain, slug])
  @@index([domain, slug])
}

model LandingPage {
  id                 String               @id @default(cuid())
  slug               String               @unique
  title              String
  description        String?
  ogImage            String?
  pixelId            String?
  sections           Json?
  redirectSettings   Json?
  status             String               @default("draft")
  createdBy          String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  content            Json?
  domainId           String?
  publishedAt        DateTime?
  seoMeta            Json?
  author             User                 @relation(fields: [createdBy], references: [id])
  Domain             Domain?              @relation(fields: [domainId], references: [id])
  leads              LandingPageLead[]
  LandingPageVersion LandingPageVersion[]

  @@index([slug])
  @@index([status])
  @@index([createdBy])
  @@index([domainId])
}

model LandingPageLead {
  id            String      @id @default(cuid())
  landingPageId String
  name          String?
  email         String?
  phone         String?
  data          Json?
  createdAt     DateTime    @default(now())
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId])
  @@index([createdAt])
}

model ContactSegment {
  id        String         @id @default(cuid())
  name      String
  createdAt DateTime       @default(now())
  contacts  BlastContact[] @relation("BlastContactToContactSegment")
}

model CampaignLink {
  id         String        @id @default(cuid())
  campaignId String
  url        String
  clicks     Int           @default(0)
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model BlastContact {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  tags               String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  campaignRecipients CampaignRecipient[]
  segments           ContactSegment[]    @relation("BlastContactToContactSegment")

  @@index([isActive])
}

model EmailCampaign {
  id           String              @id @default(cuid())
  subject      String
  bodyHtml     String
  status       String              @default("draft")
  scheduledAt  DateTime?
  attachments  Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  internalName String?
  isTemplate   Boolean             @default(false)
  previewText  String?
  links        CampaignLink[]
  recipients   CampaignRecipient[]

  @@index([status])
  @@index([scheduledAt])
}

model CampaignRecipient {
  id           String        @id @default(cuid())
  campaignId   String
  contactId    String
  status       String        @default("pending")
  errorMessage String?
  sentAt       DateTime?
  openedAt     DateTime?
  bouncedAt    DateTime?
  clickedAt    DateTime?
  device       String?
  openCount    Int           @default(0)
  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      BlastContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([status])
}

model Domain {
  id          String        @id
  name        String
  hostname    String        @unique
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  LandingPage LandingPage[]
}

model LandingPageVersion {
  id            String      @id
  landingPageId String
  content       Json
  seoMeta       Json?
  publishedAt   DateTime    @default(now())
  LandingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId])
  @@index([publishedAt])
}

model TrackingProject {
  id           String   @id @default(cuid())
  trackingCode String   @unique // Resi (misal: EL-2026-001)
  clientName   String // Nama Klien / Perusahaan
  serviceType  String // Jenis Layanan (misal: Pendirian PT)
  timelineData Json // JSONB berisi array langkah-langkah
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([trackingCode])
}
