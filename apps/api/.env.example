# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:your_password_here@host:5432/easylegal?schema=easylegal"
DIRECT_URL="postgresql://postgres:your_password_here@host:5432/easylegal?schema=easylegal"

# ============================================
# SERVER
# ============================================
PORT=4000
NODE_ENV=production

# ============================================
# AUTH
# ============================================
JWT_SECRET="generate-with-openssl-rand-base64-32"

# Shared secret for machine-to-machine calls (websiteel-app's cron route
# calls POST /api/v1/cron/process-queue with this as a Bearer token).
# Must match websiteel-app's CRON_SECRET.
CRON_SECRET="generate-with-openssl-rand-hex-32"

# Must match websiteel-app's REVALIDATION_SECRET — used by
# POST /api/v1/articles/:slug/revalidate to trigger ISR revalidation on
# the public site without the dashboard (browser code) ever holding this
# secret itself.
REVALIDATION_SECRET="generate-a-random-token"

# Public site base URL (target for the revalidate proxy above)
NEXT_PUBLIC_APP_URL="https://easylegal.biz.id"

# ============================================
# CORS — comma-separated list of allowed origins
# ============================================
CORS_ORIGINS=https://easylegal.biz.id,https://admin.easylegal.my.id

# ============================================
# EMAIL (Hostinger SMTP) — used by newsletter/email-blast routes
# ============================================
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="newsletter@easylegal.id"
SMTP_PASS="your_email_password"
SMTP_FROM='"Easy Legal" <newsletter@easylegal.id>'

# ============================================
# MINIO / S3 OBJECT STORAGE — required for /api/v1/media routes
# ============================================
# MINIO_ENDPOINT="cdn-storage"
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY="your-access-key-here"
# MINIO_SECRET_KEY="your-secret-key-here"
# MINIO_BUCKET="images"
# MINIO_PUBLIC_URL="https://easylegal.biz.id/images"

# ============================================
# SENTRY (optional)
# ============================================
# SENTRY_DSN=
