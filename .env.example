# ============================================
# DATABASE (PostgreSQL di host VPS)
# ============================================
DATABASE_URL="postgresql://easylegal:your_password_here@host.docker.internal:5432/easylegal?schema=public"
DIRECT_URL="postgresql://easylegal:your_password_here@host.docker.internal:5432/easylegal?schema=public"

# ============================================
# JWT AUTH
# ============================================
JWT_SECRET="generate-with-openssl-rand-base64-32"

# ============================================
# EMAIL (Hostinger SMTP)
# ============================================
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="newsletter@easylegal.id"
SMTP_PASS="your_email_password"
SMTP_FROM='"Easy Legal" <newsletter@easylegal.id>'

# ============================================
# APP URL
# ============================================
NEXT_PUBLIC_APP_URL="https://easylegal.biz.id"
NEXT_PUBLIC_API_URL="https://api.easylegal.my.id"

# ============================================
# MINIO / S3 OBJECT STORAGE CDN
# ============================================
# MINIO_ENDPOINT="157.10.252.77:9000"
# MINIO_ACCESS_KEY="your-access-key-here"
# MINIO_SECRET_KEY="your-secret-key-here"
# MINIO_BUCKET="images"
# MINIO_PUBLIC_URL="http://157.10.252.77:9000/images"

# ============================================
# ISR ON-DEMAND REVALIDATION
# ============================================
REVALIDATION_SECRET="generate-a-random-token"

