# ============================================
# Secrets for docker-compose.dokploy.yml
# ============================================
# Copy this file to `.env.dokploy` on the VPS (same directory as
# docker-compose.dokploy.yml, i.e. ~/easylegal/.env.dokploy) and fill in
# real values. `.env.dokploy` is gitignored — never commit it.
#
# docker compose auto-loads a file literally named `.env` for ${VAR}
# interpolation. If Dokploy invokes `docker compose` from this directory
# without an explicit --env-file flag, either:
#   a) name this file `.env` instead of `.env.dokploy`, or
#   b) configure Dokploy's build/deploy command to add:
#      --env-file .env.dokploy
# Check Dokploy's app settings for its own env-var UI first — it may
# inject these directly and make this file redundant.

# --- Database ---
DATABASE_URL=postgresql://postgres:CHANGE_ME@10.0.1.15:5432/easylegal?schema=easylegal
DIRECT_URL=postgresql://postgres:CHANGE_ME@10.0.1.15:5432/easylegal?schema=easylegal

# --- Auth ---
JWT_SECRET=generate-with-openssl-rand-base64-32
REVALIDATION_SECRET=generate-a-random-token

# --- SMTP (Hostinger) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=newsletter@easylegal.id
SMTP_PASS=CHANGE_ME
SMTP_FROM="Easy Legal" <newsletter@easylegal.id>

# --- MinIO / S3 object storage ---
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# --- Sentry ---
SENTRY_DSN=https://xxxxx@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
