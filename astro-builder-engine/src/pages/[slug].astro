---
// src/pages/[slug].astro
import '../styles/global.css';

// Karena kita menggunakan Astro dalam mode SSG (Static Site Generation), 
// kita butuh getStaticPaths untuk menentukan halaman apa saja yang akan dibuild saat production.
export async function getStaticPaths() {
  try {
    // Fetch dari PostgREST API yang baru saja Anda berikan
    const res = await fetch('https://admin.easylegal.my.id/db/LandingPage?status=eq.published');
    
    if (!res.ok) {
      console.error("Gagal mengambil data dari PostgREST", res.statusText);
      return [];
    }
    
    const pages = await res.json();

    return pages.map((page: any) => {
      // Pastikan page.sections berisi array dari JSON builder
      const sections = typeof page.sections === 'string' ? JSON.parse(page.sections) : (page.sections || []);
      
      return {
        params: { slug: page.slug },
        props: { page: { ...page, sections } }
      };
    });
  } catch (error) {
    console.error("Error fetching landing pages:", error);
    return [];
  }
}

const { page } = Astro.props;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    
    <!-- Render Sections Berdasarkan JSON -->
    <main class="min-h-screen">
      {page.sections.map((section: any) => {
        if (section.type === 'Hero') {
          return (
            <section class="bg-primary text-white py-20 px-4 text-center">
              <h1 class="text-4xl md:text-6xl font-bold mb-4">{section.content}</h1>
              <p class="text-xl mt-4">Landing Page ini di-generate super cepat menggunakan Astro SSG.</p>
            </section>
          );
        }
        
        if (section.type === 'Text') {
          return (
            <section class="max-w-4xl mx-auto py-12 px-4 text-center">
              <p class="text-lg md:text-2xl text-gray-600">{section.content}</p>
            </section>
          );
        }
        
        return null;
      })}
    </main>

  </body>
</html>
